^.*\.Rproj$                 # RStudio project file(s)
^\.Rproj\.user$             # RStudio project internals (dir)
^\.Rhistory$                # interactive history
^\.RData$                   # workspace image
^\.Renviron$                # user environment settings
^\.DS_Store$                # macOS Finder metadata

^\.git$                     # Git directory (usually unnecessary but ok)
^\.gitignore$               # Git ignore rules
^\.gitattributes$           # Git attributes
^\.github$                  # GitHub workflows, templates, etc.

^README\.Rmd$               # source README (if rendered to README.md)
^README\.Rmarkdown$         # likewise

^inst/doc$                  # built vignettes (if present)
^docs$                      # pkgdown website output
^vignettes/.*\.html$        # pre-built vignette HTML

^_pkgdown\.yml$             # pkgdown site config (common name)
^pkgdown\.yml$              # (only if you actually use this name)

^.*\.tar\.gz$               # old built bundles
^.*\.Rcheck$                # check directories
^coverage$                  # test coverage output

^renv$                      # renv project library (if used)
^renv\.lock$                # renv lockfile (optional to ignore in build)

^LICENSE\.md$
^codemeta\.json$

^data-raw$                  # raw data scripts/data
^SECURITY\.md$
^code_of_conduct\.md$

^.*\.sbatch$                # SLURM scripts (if you don’t ship them)
^.*\.pdf$                   # PDFs (if you don’t ship them)
